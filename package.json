{
  "name": "video-upload-transcoding-service",
  "version": "1.0.0",
  "description": "Video upload and transcoding service with chunked uploads, BullMQ job queue, and FFmpeg transcoding",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test --test-concurrency 1 test/*.test.js",
    "test:integration": "node --test test/integration.test.js",
    "test:cache": "node --test test/cache.test.js",
    "test:concurrency": "node --test test/concurrency.test.js",
    "generate-fixtures": "node fixtures/generate.js"
  },
  "dependencies": {
    "bullmq": "^5.12.0",
    "express": "^4.21.0",
    "ioredis": "^5.4.1",
    "multer": "^1.4.5-lts.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=20.0.0"
  }
}
